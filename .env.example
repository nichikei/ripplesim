# Copy to .env (git-ignored) to enable the LLM layer.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional model overrides. Defaults pick the cheapest model that does each
# job well: Haiku writes the posts (high volume, simple task), Sonnet handles
# the interview and the report agent (reasoning quality matters).
# RIPPLESIM_POST_MODEL=claude-haiku-4-5
# RIPPLESIM_CHAT_MODEL=claude-sonnet-5
# RIPPLESIM_REPORT_MODEL=claude-sonnet-5
